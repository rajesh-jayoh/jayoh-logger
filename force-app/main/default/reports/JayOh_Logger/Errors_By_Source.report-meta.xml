<?xml version="1.0" encoding="UTF-8"?>
<Report xmlns="http://soap.sforce.com/2006/04/metadata">
    <name>Errors by Source</name>
    <description>JayOh Logger: count of ERROR-level entries grouped by source (class.method), for spotting a flaky integration before the client does.</description>
    <reportType>Log_And_Log_Entries</reportType>
    <format>Summary</format>
    <showDetails>false</showDetails>
    <groupingsDown>
        <field>Log__c.Log_Entries__r.Source__c</field>
        <sortOrder>Desc</sortOrder>
    </groupingsDown>
    <columns>
        <field>Log__c.Log_Entries__r.Source__c</field>
    </columns>
    <columns>
        <field>Log__c.Log_Entries__r.Message__c</field>
    </columns>
    <filter>
        <criteriaItems>
            <column>Log__c.Log_Entries__r.Level__c</column>
            <operator>equals</operator>
            <value>ERROR</value>
        </criteriaItems>
        <criteriaItems>
            <column>Log__c.CREATED_DATE</column>
            <operator>equals</operator>
            <value>LAST_N_DAYS:30</value>
        </criteriaItems>
        <language>en_US</language>
    </filter>
</Report>
